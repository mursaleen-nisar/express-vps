forgefluxhq.com {
    tls mursaleen@forgefluxhq.com
    
    handle {
        reverse_proxy nodejs-server:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}